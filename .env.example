# Local backend runtime only. Docker always uses /app/data/smartcrm.sqlite
# in the existing sqlite_data named volume; this is NOT a Windows host path.
DB_PATH=data/smartcrm.sqlite
 
# Local backend runtime (npm run server); also the Vite development proxy target.
# Docker overrides these with 0.0.0.0:3000 inside the API container.
APP_PORT=3000
APP_HOST=127.0.0.1
# Backend runtime, local and Docker. Never put secrets in VITE_* variables.
LOG_LEVEL=info
DEMO_PASSWORD=
# Public frontend build-time setting (and Vite dev). Docker explicitly builds /api
# so browser requests go through Nginx; changing this locally does not change Docker.
VITE_API_BASE_URL=/api

# Docker host ports only: host API_HOST_PORT -> api:3000; WEB_PORT -> web:80.
# Keep the Compose project name/directory unchanged to reuse its existing volume.
API_HOST_PORT=3000
WEB_PORT=8080
